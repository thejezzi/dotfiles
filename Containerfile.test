# Fresh-machine test image for the dotfiles.
# Deliberately installs NOTHING beyond the base image: apply.sh must bootstrap
# zsh, stow, all CLI tools, oh-my-zsh, plugins and TPM itself. The smoke test
# then asserts the results.
FROM fedora:latest

# Repo is mounted read-only at runtime (podman run -v ...:/dotfiles:ro,z).
WORKDIR /dotfiles

ENTRYPOINT ["tests/smoke.sh", "/dotfiles"]
